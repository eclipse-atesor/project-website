---
import Section from './Section.astro';
import Icon from './Icon.astro';
import { featureGroups } from '../data/content';

/**
 * A real <table>: capability on the left, what it gets you on the right,
 * with a spanning header row per group. The previous card grid made every
 * item look equally weighted and forced the eye to zig-zag; a table lets a
 * reader scan one column and stop where something interests them.
 */
const groupIcons = ['box', 'refresh', 'lock', 'brain'];
---

<Section
  id="features"
  eyebrow="Capabilities"
  title="Built to keep working when things go wrong."
  lede="Rate limits, flaky emulation, hallucinated package names, silent OOM kills. The failure modes of an autonomous build agent are well understood here, and each has a deterministic answer."
>
  <div class="table-wrap scroll-x" data-reveal>
    <table class="feat-table">
      <caption class="sr-only">
        Eclipse Atesor capabilities, grouped by area, with the benefit of each.
      </caption>
      <thead>
        <tr>
          <th scope="col">Capability</th>
          <th scope="col">What it gets you</th>
        </tr>
      </thead>
      {
        featureGroups.map((g, gi) => (
          <tbody>
            <tr class="group-row">
              <th scope="colgroup" colspan="2">
                <span class="group-icon">
                  <Icon name={groupIcons[gi]} size={14} />
                </span>
                {g.group}
              </th>
            </tr>
            {g.items.map(([name, benefit]) => (
              <tr>
                <th scope="row">{name}</th>
                <td>{benefit}</td>
              </tr>
            ))}
          </tbody>
        ))
      }
    </table>
  </div>
</Section>

<style>
  .table-wrap {
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-bg-card);
  }

  .feat-table {
    width: 100%;
    min-width: 34rem;
    border-collapse: collapse;
    text-align: left;
  }

  .feat-table thead th {
    text-align: left;
    padding: 0.85rem 1.35rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    border-bottom: 1px solid var(--color-border);
  }

  .group-row th {
    text-align: left;
    padding: 1.1rem 1.35rem 0.6rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-accent);
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-bg-inset) 55%, transparent);
  }

  .group-icon {
    display: inline-flex;
    vertical-align: -2px;
    margin-right: 0.5rem;
    color: var(--color-accent);
  }

  .feat-table tbody tr:not(.group-row) th {
    text-align: left;
    padding: 0.8rem 1.35rem;
    width: 38%;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text);
    vertical-align: top;
  }

  .feat-table tbody tr:not(.group-row) td {
    padding: 0.8rem 1.35rem;
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--color-text-muted);
    vertical-align: top;
  }

  /* Hairline between rows, but not before a group header or after the last. */
  .feat-table tbody tr:not(.group-row) + tr:not(.group-row) th,
  .feat-table tbody tr:not(.group-row) + tr:not(.group-row) td {
    border-top: 1px solid color-mix(in srgb, var(--color-border) 70%, transparent);
  }

  .feat-table tbody:last-child tr:last-child th,
  .feat-table tbody:last-child tr:last-child td {
    padding-bottom: 1.1rem;
  }
</style>
