---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { project } from '../data/content';
import { url } from '../lib/url';

/** In-page anchors only work from the landing page, so prefix them with '/'
 *  rather than '#' — from /downloads they must navigate home first. */
const nav = [
  { label: 'How it works', href: url('/#pipeline') },
  { label: 'Features', href: url('/#features') },
  { label: 'Get started', href: url('/#quickstart') },
  { label: 'Downloads', href: url('/downloads') },
  { label: 'Community', href: url('/#community') },
];
---

<header class="site-header">
  <div class="container-x header-inner">
    <a href={url('/')} class="brand" aria-label={`${project.formalName} home`}>
      <Logo size={30} decorative />
      <span class="brand-text">
        <span class="brand-eclipse">Eclipse</span><span class="brand-name">Atesor</span>
      </span>
    </a>

    <nav class="nav-desktop" aria-label="Primary">
      {nav.map((i) => <a href={i.href}>{i.label}</a>)}
    </nav>

    <div class="header-actions">
      <a
        href={project.urls.repo}
        class="btn btn-secondary btn-sm"
        rel="noopener"
        target="_blank"
      >
        <Icon name="github" size={16} />
        <span class="gh-label">GitHub</span>
      </a>
      <button
        class="nav-toggle"
        aria-label="Toggle navigation"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="nav-mobile" aria-label="Primary mobile" hidden>
    {nav.map((i) => <a href={i.href}>{i.label}</a>)}
  </nav>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const panel = document.querySelector<HTMLElement>('#mobile-nav');
  const header = document.querySelector<HTMLElement>('.site-header');

  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    if (panel) panel.hidden = open;
    btn.classList.toggle('is-open', !open);
  });

  // Close the mobile panel after following an in-page anchor.
  panel?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).tagName !== 'A') return;
    btn?.setAttribute('aria-expanded', 'false');
    btn?.classList.remove('is-open');
    panel.hidden = true;
  });

  // Solidify the header background once the hero has scrolled away.
  const onScroll = () => header?.classList.toggle('is-stuck', window.scrollY > 12);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      backdrop-filter 0.25s ease;
  }

  .site-header.is-stuck {
    background: color-mix(in srgb, var(--color-bg) 82%, transparent);
    backdrop-filter: blur(12px) saturate(140%);
    border-bottom-color: var(--color-border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 4.25rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    flex-shrink: 0;
  }

  .brand-text {
    font-size: 1.0625rem;
    letter-spacing: -0.015em;
    white-space: nowrap;
  }

  .brand-eclipse {
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .brand-name {
    color: var(--color-text);
    font-weight: 700;
    margin-left: 0.28em;
  }

  .nav-desktop {
    display: none;
    gap: 1.9rem;
    font-size: 0.9rem;
  }

  .nav-desktop a {
    color: var(--color-text-dim);
    transition: color 0.15s ease;
  }

  .nav-desktop a:hover {
    color: var(--color-text);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .btn-sm {
    padding: 0.5rem 0.9rem;
    font-size: 0.85rem;
  }

  .gh-label {
    display: none;
  }

  /* Hamburger */
  .nav-toggle {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 40px;
    height: 40px;
    padding: 0 9px;
    border: 1px solid var(--color-border-bright);
    border-radius: 8px;
    background: transparent;
    cursor: pointer;
  }

  .nav-toggle span {
    display: block;
    height: 1.5px;
    background: var(--color-text);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .nav-toggle.is-open span:nth-child(1) {
    transform: translateY(5.5px) rotate(45deg);
  }
  .nav-toggle.is-open span:nth-child(2) {
    opacity: 0;
  }
  .nav-toggle.is-open span:nth-child(3) {
    transform: translateY(-5.5px) rotate(-45deg);
  }

  .nav-mobile {
    display: flex;
    flex-direction: column;
    padding: 0.5rem clamp(1.25rem, 4vw, 2.5rem) 1.25rem;
    background: color-mix(in srgb, var(--color-bg) 96%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
  }

  .nav-mobile a {
    padding: 0.75rem 0;
    color: var(--color-text-dim);
    border-bottom: 1px solid var(--color-border);
    font-size: 0.95rem;
  }

  .nav-mobile a:last-child {
    border-bottom: 0;
  }

  @media (min-width: 900px) {
    .nav-desktop {
      display: flex;
    }
    .nav-toggle {
      display: none;
    }
    .gh-label {
      display: inline;
    }
  }

</style>
