---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { project } from '../data/content';
import { url } from '../lib/url';

/** Two destinations and the source. The landing page is one short read, so
 *  it needs no in-page anchors and no mobile menu: the links fit at 320 px. */
const path = Astro.url.pathname.replace(/\/$/, '');
const nav = [
  { label: 'Docs', href: url('/docs/') },
  { label: 'Packages', href: url('/downloads'), current: path.endsWith('/downloads') },
];
---

<header class="site-header">
  <div class="container-x header-inner">
    <a href={url('/')} class="brand" aria-label={`${project.formalName} home`}>
      <Logo size={30} decorative />
      <span class="brand-text">
        <span class="brand-eclipse">Eclipse</span><span class="brand-name">Atesor</span>
      </span>
    </a>

    <nav class="nav" aria-label="Primary">
      {
        nav.map((i) => (
          <a href={i.href} aria-current={i.current ? 'page' : undefined}>
            {i.label}
          </a>
        ))
      }
      <a href={project.urls.repo} class="gh" rel="noopener" target="_blank">
        <Icon name="github" size={16} />
        <span class="gh-label">GitHub</span>
        <span class="sr-only gh-sr">GitHub</span>
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: blur(10px) saturate(140%);
    border-bottom: 1px solid var(--color-border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 3.75rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    flex-shrink: 0;
  }

  .brand-text {
    font-size: 1rem;
    letter-spacing: -0.015em;
    white-space: nowrap;
  }

  .brand-eclipse {
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .brand-name {
    color: var(--color-text);
    font-weight: 700;
    margin-left: 0.28em;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 3vw, 1.75rem);
    font-size: 0.9375rem;
  }

  .nav a {
    color: var(--color-text-dim);
    text-underline-offset: 6px;
    transition: color 0.15s ease;
  }

  .nav a:hover,
  .nav a[aria-current='page'] {
    color: var(--color-text);
  }

  .nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
  }

  .gh {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .gh-label {
    display: none;
  }

  @media (min-width: 560px) {
    .gh-label {
      display: inline;
    }
    .gh-sr {
      display: none;
    }
  }

  @media (max-width: 360px) {
    .brand-eclipse {
      display: none;
    }
    .brand-name {
      margin-left: 0;
    }
  }
</style>
