---
import Section from './Section.astro';
import CodeBlock from './CodeBlock.astro';
import Icon from './Icon.astro';
import { project, platforms } from '../data/content';

/**
 * Two install methods, toggled. The Debian package leads because most people
 * want to *use* Atesor, not develop it — the packaged CLI bundles its own
 * virtualenv, so there is no Python setup at all.
 *
 * Kept deliberately short: three steps each.
 *
 * Commands verified against packaging/deb/ and main.py — notably that
 * ~/.config/atesor-ai/.env is a real load path.
 */

const CMD = (t: string) => ({ t, c: 'cmd' });
const F = (t: string) => ({ t, c: 'flag' });
const S = (t: string) => ({ t, c: 'str' });
const P = (t: string) => ({ t, c: 'path' });

const REPO = 'https://github.com/madler/zlib';

const debSteps = [
  {
    title: 'Install',
    link: { href: project.urls.latestRelease, label: 'Download .deb' },
    lines: [
      [CMD('sudo'), { t: ' apt-get install ./' }, P('atesor-ai_<version>_<arch>.deb')],
    ],
    raw: 'sudo apt-get install ./atesor-ai_<version>_<arch>.deb',
  },
  {
    title: 'Add an API key',
    lines: [
      [CMD('cp'), { t: ' /opt/atesor-ai/app/.env-example ~/.config/atesor-ai/.env' }],
    ],
    raw: 'cp /opt/atesor-ai/app/.env-example ~/.config/atesor-ai/.env',
  },
  {
    title: 'Port a package',
    lines: [
      [CMD('atesor-ai'), { t: ' ' }, F('--setup-only')],
      [CMD('atesor-ai'), { t: ' ' }, F('--repo'), { t: ' ' }, S(REPO)],
    ],
    raw: `atesor-ai --setup-only\natesor-ai --repo ${REPO}`,
  },
];

const srcSteps = [
  {
    title: 'Clone',
    lines: [
      [CMD('git'), { t: ' clone ' }, S(project.urls.repo), { t: ' && ' }, CMD('cd'), { t: ' atesor' }],
    ],
    raw: `git clone ${project.urls.repo} && cd atesor`,
  },
  {
    title: 'Install and add an API key',
    lines: [
      [CMD('pip'), { t: ' install ' }, F('-r'), { t: ' requirements.txt' }],
      [CMD('cp'), { t: ' .env-example .env' }],
    ],
    raw: 'pip install -r requirements.txt\ncp .env-example .env',
  },
  {
    title: 'Port a package',
    lines: [
      [CMD('python3'), { t: ' main.py ' }, F('--setup-only')],
      [CMD('python3'), { t: ' main.py ' }, F('--repo'), { t: ' ' }, S(REPO)],
    ],
    raw: `python3 main.py --setup-only\npython3 main.py --repo ${REPO}`,
  },
];

const methods = [
  { id: 'deb', label: 'Debian package', steps: debSteps },
  { id: 'src', label: 'From source', steps: srcSteps },
];
---

<Section
  id="quickstart"
  raised
  eyebrow="Get started"
  title="One command per package."
  lede="The packaged CLI bundles its own runtime. You supply a Docker daemon with riscv64 emulation enabled, and an API key for Gemini, OpenAI or OpenRouter."
>
  <div class="qs-layout">
    <div class="qs-main">
      <div class="methods" data-tabs>
        <div class="seg" role="tablist" aria-label="Installation method">
          {
            methods.map((m, i) => (
              <button
                role="tab"
                id={`mtab-${m.id}`}
                aria-controls={`mpanel-${m.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                class:list={['tab', { active: i === 0 }]}
              >
                {m.label}
              </button>
            ))
          }
        </div>

        {
          methods.map((m, i) => (
            <div
              role="tabpanel"
              id={`mpanel-${m.id}`}
              aria-labelledby={`mtab-${m.id}`}
              class="tab-panel"
              hidden={i !== 0}
            >
              <ol class="steps">
                {m.steps.map((s) => (
                  <li>
                    <div class="step-head">
                      <h3 class="h3">{s.title}</h3>
                      {s.link && (
                        <a class="step-dl" href={s.link.href} rel="noopener" target="_blank">
                          {s.link.label}
                          <Icon name="arrowRight" size={12} />
                        </a>
                      )}
                    </div>
                    <CodeBlock lines={s.lines} raw={s.raw} />
                  </li>
                ))}
              </ol>
            </div>
          ))
        }
      </div>
    </div>

    <aside class="qs-side">
      <div class="card side-card">
        <h3 class="side-h">Sandboxes</h3>
        <ul class="pf-list">
          {
            platforms.map((p) => (
              <li>
                <strong>{p.name}</strong>
                <code>{p.triplet}</code>
                <span>{p.libc}</span>
              </li>
            ))
          }
        </ul>
        <p class="side-note">
          Both run natively under QEMU/binfmt. Nothing is cross-compiled. Add{' '}
          <code>--platform debian</code> to target glibc.
        </p>
      </div>

      <a href={project.urls.repo} class="btn btn-secondary side-btn" rel="noopener" target="_blank">
        <Icon name="book" size={16} />
        Full documentation
      </a>
    </aside>
  </div>
</Section>

<script>
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((wrap) => {
    const tabs = Array.from(wrap.querySelectorAll<HTMLButtonElement>(':scope > * > .tab'));
    const panels = Array.from(wrap.querySelectorAll<HTMLElement>(':scope > .tab-panel'));

    const select = (idx: number) => {
      tabs.forEach((t, i) => {
        t.classList.toggle('active', i === idx);
        t.setAttribute('aria-selected', String(i === idx));
      });
      panels.forEach((p, i) => (p.hidden = i !== idx));
    };

    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        e.preventDefault();
        const next = (i + (e.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
        tabs[next].focus();
        select(next);
      });
    });
  });
</script>

<style>
  .qs-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  /* --- segmented control --- */
  .seg {
    display: inline-flex;
    padding: 4px;
    gap: 4px;
    margin-bottom: 2rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-bg-inset);
  }

  .tab {
    padding: 0.5rem 1.15rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-muted);
    cursor: pointer;
    white-space: nowrap;
    transition:
      background-color 0.18s ease,
      color 0.18s ease;
  }

  .tab:hover {
    color: var(--color-text-dim);
  }

  .tab.active {
    background: linear-gradient(180deg, var(--color-accent), var(--color-accent-hot));
    color: #14100a;
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.25) inset;
  }

  /* --- steps --- */
  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: step;
    display: grid;
    gap: 1.5rem;
  }

  .steps li {
    counter-increment: step;
  }

  .step-head {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 0.65rem;
  }

  .step-head h3 {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  /* Numbered from the counter so reordering steps can't desync the labels. */
  .step-head h3::before {
    content: counter(step);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-accent) 15%, transparent);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    flex-shrink: 0;
  }

  .step-dl {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.28rem 0.7rem;
    border: 1px solid color-mix(in srgb, var(--color-accent) 45%, transparent);
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-accent);
    white-space: nowrap;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .step-dl:hover {
    background: color-mix(in srgb, var(--color-accent) 20%, transparent);
    border-color: var(--color-accent);
  }

  /* --- sidebar --- */
  .qs-side {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .side-card {
    padding: 1.25rem 1.35rem 1.35rem;
  }

  .side-h {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text);
    margin: 0 0 0.9rem;
  }

  .pf-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.85rem;
  }

  .pf-list li {
    display: grid;
    gap: 0.15rem;
  }

  .pf-list strong {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .pf-list code {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-verified);
  }

  .pf-list > li > span {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-text-muted);
  }

  .side-note {
    margin: 1rem 0 0;
    padding-top: 0.9rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.78rem;
    line-height: 1.55;
    color: var(--color-text-muted);
  }

  .side-note code {
    font-family: var(--font-mono);
    font-size: 0.92em;
    color: var(--color-accent);
  }

  .side-btn {
    justify-content: center;
  }

  @media (min-width: 1000px) {
    .qs-layout {
      grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
      gap: 3rem;
    }
  }
</style>
