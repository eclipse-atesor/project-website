---
import Icon from './Icon.astro';
import Terminal from './Terminal.astro';
import { project } from '../data/content';
import { url } from '../lib/url';
import manifest from '../../public/assets/packages.json';

/* The package count comes from the same manifest the /downloads page reads,
   so the two pages can never disagree. */
const packageCount = manifest.unique.toLocaleString('en-US');
---

<section class="hero stone">
  <div class="container-x hero-inner">
    <div class="hero-copy">
      <!-- Handbook: the first and most prominent reference must be the
           formal name carrying the trademark symbol. -->
      <h1 class="hero-title">Eclipse Atesor<span class="tm">™</span></h1>

      <p class="hero-tagline">{project.tagline}</p>

      <p class="hero-lede">
        An open-source agentic framework that ports software to RISC-V. Give it a repository
        URL. It builds the package natively on <code>riscv64</code>, repairs what breaks, checks
        every binary, and writes a recipe that anyone can replay.
      </p>

      <div class="hero-actions">
        <a href={url('/docs/getting-started/install/')} class="btn btn-primary">
          Get started
          <Icon name="arrowRight" size={16} />
        </a>
        <a href={url('/downloads')} class="btn btn-secondary">
          Browse {packageCount} packages
        </a>
      </div>

    </div>

    <div class="hero-run">
      <Terminal />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    /* The page ground outside the stone, for the cut corner below. */
    --cut: clamp(36px, 5vw, 64px);
  }

  /* The cut corner of the logo's stone, at the hero's bottom left. */
  .hero::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -1px;
    width: var(--cut);
    height: var(--cut);
    background: var(--page-ground);
    clip-path: polygon(0 0, 0 100%, 100% 100%);
  }

  .hero-inner {
    display: grid;
    gap: clamp(2.5rem, 5vw, 3.5rem);
    padding-block: clamp(3rem, 7vw, 5.5rem) clamp(3.5rem, 8vw, 6rem);
    align-items: center;
  }

  @media (min-width: 1000px) {
    .hero-inner {
      grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    }
  }

  .hero-title {
    margin: 0;
    font-size: clamp(2.4rem, 4.2vw, 3.6rem);
    font-weight: 750;
    letter-spacing: -0.03em;
    line-height: 1.02;
    text-wrap: balance;
  }

  .tm {
    font-size: 0.32em;
    font-weight: 500;
    vertical-align: 1.9em;
    margin-left: 0.08em;
    color: var(--color-text-muted);
  }

  .hero-tagline {
    margin: 0.85rem 0 0;
    font-size: clamp(1.35rem, 2.4vw, 1.9rem);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.2;
    color: var(--color-accent);
  }

  .hero-lede {
    margin: 1.4rem 0 0;
    max-width: 46ch;
    font-size: clamp(1.05rem, 1.4vw, 1.15rem);
    line-height: 1.65;
    color: var(--color-text-dim);
  }

  .hero-lede code {
    font-family: var(--font-mono);
    font-size: 0.92em;
    color: var(--color-text);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero-run {
    min-width: 0;
  }
</style>
