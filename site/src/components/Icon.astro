---
/**
 * Inline icon set. Hand-drawn on a 24x24 grid, stroke-based so they inherit
 * currentColor and line up with the type. No icon-font dependency — the site
 * makes zero third-party requests by design (see DESIGN.md §3).
 */
interface Props {
  name: string;
  size?: number;
  class?: string;
  stroke?: number;
}
const { name, size = 20, class: klass = '', stroke = 1.6 } = Astro.props;

