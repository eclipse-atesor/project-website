const d = paths[name] ?? '';
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={klass}
  aria-hidden="true"
  focusable="false"
>
  {d.split('M').filter(Boolean).map((seg) => <path d={`M${seg}`} />)}
</svg>
