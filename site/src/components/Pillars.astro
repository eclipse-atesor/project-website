---
import Section from './Section.astro';
import Icon from './Icon.astro';
import { pillars } from '../data/content';

const icons = ['bolt', 'brain', 'layers'];
---

<Section
  eyebrow="Architecture"
  title="Three pillars hold the whole thing up."
>
  <div class="pillar-grid">
    {
      pillars.map((p, i) => (
        <article class="card card-lit pillar" data-reveal data-reveal-delay={i * 90}>
          <span class="pillar-icon">
            <Icon name={icons[i]} size={20} />
          </span>
          <h3 class="pillar-title">{p.title}</h3>
          <code class="pillar-file">{p.file}</code>
          <p>{p.body}</p>
          <ul>
            {p.points.map((pt) => (
              <li>
                <Icon name="check" size={13} />
                {pt}
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</Section>

<style>
  .pillar-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.15rem;
  }

  .pillar {
    padding: 1.6rem 1.6rem 1.75rem;
    display: flex;
    flex-direction: column;
  }

  .pillar-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 26%, transparent);
    margin-bottom: 1.1rem;
  }

  .pillar-title {
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    margin: 0 0 0.35rem;
  }

  .pillar-file {
    font-family: var(--font-mono);
    font-size: 0.73rem;
    color: var(--color-text-muted);
    margin-bottom: 0.9rem;
  }

  .pillar p {
    margin: 0 0 1.15rem;
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--color-text-dim);
  }

  .pillar ul {
    list-style: none;
    padding: 0;
    margin: auto 0 0;
    display: grid;
    gap: 0.5rem;
    border-top: 1px solid var(--color-border);
    padding-top: 1.1rem;
  }

  .pillar li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--color-text-dim);
  }

  .pillar li :global(svg) {
    color: var(--color-verified);
    flex-shrink: 0;
  }

  @media (min-width: 900px) {
    .pillar-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
