---
import Icon from './Icon.astro';
import { url } from '../lib/url';

/* What a port gives back. File names and formats: docs page
   reference/output-files (code on main). */
const gets = [
  { icon: 'check', label: 'Verified binaries', note: 'Every output is riscv64.' },
  { icon: 'book', label: 'A recipe', note: 'Steps a CI job can replay.' },
  { icon: 'layers', label: 'The patches', note: 'Each fix, as a .patch file.' },
  { icon: 'scale', label: 'A full log', note: 'Every model call and its cost.' },
];
---

<section class="recipe-sec" aria-labelledby="recipe-title">
  <div class="container-x recipe-grid">
    <div class="recipe-copy">
      <h2 id="recipe-title" class="h2">Every port ends in a recipe</h2>
      <p class="lede">
        Each port gives back a Markdown recipe: the steps that built the package. A person or a CI
        job can replay it.
      </p>

      <ul class="gets">
        {
          gets.map((g) => (
            <li>
              <span class="gets-icon">
                <Icon name={g.icon} size={18} />
              </span>
              <span class="gets-text">
                <strong>{g.label}</strong>
                <span>{g.note}</span>
              </span>
            </li>
          ))
        }
      </ul>

      <a class="more" href={url('/docs/getting-started/read-the-output/')}>
        Read the output
        <Icon name="arrowRight" size={14} />
      </a>
    </div>

    <figure class="recipe code-surface">
      <figcaption>
        <span>zlib_recipe.md</span>
        <span class="note">Shortened example</span>
      </figcaption>
      <pre><code><span class="h"># zlib on alpine-riscv64</span>

<span class="h">## Executive Summary</span>
Verified riscv64 build of zlib with autotools.

<span class="h">## Prerequisites</span>
apk add build-base autoconf automake libtool

<span class="h">## Build Instructions</span>
./configure --prefix=/usr
make -j4

<span class="h">## Verification</span>
file libz.so.1.3.1
<span class="ok">ELF 64-bit LSB shared object, UCB RISC-V</span>

<span class="h">## Known Issues &amp; Recommendations</span>
<span class="dim">…</span></code></pre>
    </figure>
  </div>
</section>

<style>
  .recipe-sec {
    padding-block: clamp(4rem, 8vw, 6.5rem);
    background: var(--color-bg-raised);
    border-block: 1px solid var(--color-border);
  }

  .recipe-grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: start;
  }

  @media (min-width: 960px) {
    .recipe-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .recipe-copy .h2 {
    margin: 0;
    max-width: 18ch;
  }

  .recipe-copy .lede {
    margin: 1rem 0 0;
  }

  .gets {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.1rem 1.5rem;
  }

  @media (min-width: 560px) {
    .gets {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .gets li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin: 0;
  }

  .gets-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 10px;
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
  }

  .gets-text {
    display: grid;
    gap: 0.1rem;
  }

  .gets-text strong {
    font-weight: 650;
    color: var(--color-text);
  }

  .gets-text span {
    font-size: 0.9rem;
    color: var(--color-text-dim);
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 1.5rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  .more:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .recipe {
    margin: 0;
    overflow: hidden;
  }

  .recipe figcaption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1.15rem;
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text);
  }

  .recipe .note {
    font-family: var(--font-sans);
    color: var(--color-text-muted);
  }

  .recipe pre {
    margin: 0;
    padding: 1.15rem 1.25rem 1.35rem;
    overflow-x: auto;
    color: var(--color-text-dim);
  }

  .recipe .h {
    color: var(--color-text);
    font-weight: 600;
  }

  .recipe .ok {
    color: var(--color-verified);
  }

  .recipe .dim {
    color: var(--color-text-muted);
  }
</style>
