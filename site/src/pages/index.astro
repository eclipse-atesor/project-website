---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Steps from '../components/Steps.astro';
import Recipe from '../components/Recipe.astro';
import Packages from '../components/Packages.astro';
import Install from '../components/Install.astro';
import OpenProject from '../components/OpenProject.astro';
import { project } from '../data/content';

/*
 * One short read, in the order a visitor asks: what is it, how does a port
 * run, what do I get back, has it worked, how do I start, who runs it.
 * Detail lives in /docs; each section links to its page there.
 */
---

<Base
  title="Agentic framework for RISC-V software porting"
  description={project.descriptor}
  ogPath="/"
>
  <Hero />
  <Steps />
  <Recipe />
  <Packages />
  <Install />
  <OpenProject />
</Base>
