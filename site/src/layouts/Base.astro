---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { project } from '../data/content';
import { url } from '../lib/url';

interface Props {
  /** Page-specific title. The formal name + ™ is appended automatically so
   *  every <title> satisfies the EF first-reference trademark rule. */
  title: string;
  description: string;
  /** Set on the home page so the H1 there carries the formal name. */
  ogPath?: string;
}

const { title, description, ogPath = '/' } = Astro.props;
const fullTitle = `${title} | ${project.formalName}™`;
// Trailing slash: eclipse.dev answers /atesor and /atesor/downloads with a
// 301 to the slash form, and the sitemap lists the slash form.
const canonical = `${project.urls.website}${ogPath.endsWith('/') ? ogPath : `${ogPath}/`}`;
const ogImage = `${project.urls.website}/brand/og-image.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="icon" type="image/png" sizes="32x32" href={url('/favicon-32.png')} />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="manifest" href={url('/site.webmanifest')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <link rel="alternate" type="text/plain" title="llms.txt" href={url('/llms.txt')} />
    <meta name="theme-color" content="#f2f2ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111316" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${project.formalName}™`} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Eclipse Atesor logo and the line: From source to verified riscv64." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'SoftwareSourceCode',
            '@id': `${project.urls.website}/#source`,
            name: `${project.formalName}™`,
            alternateName: ['Atesor', 'atesor-ai'],
            description: project.definition,
            url: `${project.urls.website}/`,
            codeRepository: project.urls.repo,
            programmingLanguage: 'Python',
            runtimePlatform: 'Linux',
            targetProduct: { '@id': `${project.urls.website}/#app` },
            license: 'https://opensource.org/licenses/MIT',
            keywords: [
              'RISC-V',
              'riscv64',
              'software porting',
              'agentic framework',
              'LangGraph',
              'native builds',
              'Alpine',
              'Debian',
            ],
          },
          {
            '@type': 'SoftwareApplication',
            '@id': `${project.urls.website}/#app`,
            name: `${project.formalName}™`,
            applicationCategory: 'DeveloperApplication',
            operatingSystem: 'Linux',
            softwareHelp: `${project.urls.website}/docs/`,
            downloadUrl: project.urls.releases,
            license: 'https://opensource.org/licenses/MIT',
            offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
            publisher: {
              '@type': 'Organization',
              name: 'Eclipse Foundation',
              url: 'https://www.eclipse.org',
            },
          },
        ],
      })}
    />
  </head>

  <body>
    <!--
      UX-02. [data-reveal] is opacity:0 until the IntersectionObserver adds
      .is-visible, so with JavaScript disabled every revealed section renders
      blank. Restore them unconditionally when JS is off.
    -->
    <noscript>
      <style>
        [data-reveal] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>

    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Scroll reveal. The hiding CSS is gated behind
      // prefers-reduced-motion:no-preference, so reduced-motion users never
      // see it applied. Default-motion users WITH JS disabled are covered by
      // the <noscript> override above — without that, this script failing to
      // run leaves the content permanently invisible.
      const els = document.querySelectorAll('[data-reveal]');
      if (
        'IntersectionObserver' in window &&
        window.matchMedia('(prefers-reduced-motion: no-preference)').matches
      ) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              const el = e.target as HTMLElement;
              const delay = Number(el.dataset.revealDelay ?? 0);
              setTimeout(() => el.classList.add('is-visible'), delay);
              io.unobserve(el);
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.08 }
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }
    </script>

    <style>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        padding: 0.75rem 1.25rem;
        background: var(--color-accent);
        color: #14100a;
        font-weight: 600;
        border-radius: 0 0 8px 0;
      }
      .skip-link:focus {
        left: 0;
      }
    </style>
  </body>
</html>
